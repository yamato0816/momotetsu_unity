{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "railtrip-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RailRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RailRoom"] }
  ],
  "observability": { "enabled": true }
}
